# Production Environment Variables Example
# Copy this to .env for production and fill with actual values
# NEVER commit .env file to git!

# Database Passwords (Production)
AUTH_DB_PASSWORD=
EVALUATION_DB_PASSWORD=
EVENT_DB_PASSWORD=
INVITATION_DB_PASSWORD=
PROJECT_DB_PASSWORD=

# Database URLs (Production)
AUTH_DATABASE_URL=postgresql://postgres:password@auth-db:5432/auth_service
EVALUATION_DATABASE_URL=postgresql://postgres:password@evaluation-db:5432/evaluation_service
EVENT_DATABASE_URL=postgresql://postgres:password@event-db:5432/event_service
INVITATION_DATABASE_URL=postgresql://postgres:password@invitation-db:5432/invitation_service
PROJECT_DATABASE_URL=postgresql://postgres:password@project-db:5432/project_service

# JWT Configuration
JWT_SECRET=
JWT_EXPIRATION=3600

# Service URLs (Internal - Docker network)
AUTH_SERVICE_URL=auth-service:50051
EVALUATION_SERVICE_URL=evaluation-service:50052
EVENT_SERVICE_URL=event-service:50053
INVITATION_SERVICE_URL=invitation-service:50054
PROJECT_SERVICE_URL=project-service:50055
NOTIFICATION_SERVICE_URL=notification-service:50056

# Email Service (EmailJS)
EMAIL_SERVICE_ID=
EMAIL_TEMPLATE_ID=
EMAIL_PUBLIC_KEY=
EMAIL_PRIVATE_KEY=
