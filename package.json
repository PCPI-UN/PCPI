{
  "name": "pcpi",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "husky",
    "proto:generate": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto -I ./libs/common/src/protos --ts_proto_out=./libs/common/src/generated --ts_proto_opt=nestJs=true --ts_proto_opt=useDate=true --ts_proto_opt=esModuleInterop=true ./libs/common/src/protos/*.proto",
    "proto:generate:win": "for %f in (libs/common/src/protos/*.proto) do protoc -I ./libs/common/src/protos --ts_proto_out=./libs/common/src/generated --ts_proto_opt=nestJs=true,esModuleInterop=true %f",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/gateway/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/gateway/test/jest-e2e.json"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/storage-blob": "^12.31.0",
    "@grpc/grpc-js": "^1.14.3",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.18",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "^6.19.3",
    "@types/qs": "^6.15.0",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.9",
    "luxon": "^3.7.2",
    "nest": "^0.1.6",
