    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.17",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.18",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.15.24",
    "@types/bcrypt": "^6.0.0",
